# App ports
FRONTEND_PORT=8400

# Frontend build/runtime variables
# IMPORTANT: Because frontend uses Nginx proxy_pass, use internal Docker DNS URL.
VITE_BACKEND_URL=
VITE_DOCUMENT_FILE_URL_TEMPLATE=https://your-domain/api/v1/documents/{documentId}/file
VITE_MAINTENANCE_MESSAGE=

# dùng databse guideline management
DB_HOST=postgres
DB_PORT=5432
DB_NAME=db
DB_USER=postgres
DB_PASS=postgres

# Backend auth
JWT_SECRET=change_me_for_local_development

# Chat API - LLM sinh văn bản: Qwen3.6-27B trên Server A (vLLM, OpenAI-compatible)
# LLM_BASE_URL phải truy cập được từ BÊN TRONG container chat-api:
#   - SSH tunnel trên máy host (ssh -N -L 8001:127.0.0.1:8000 <user>@<server-a>):
#       http://host.docker.internal:8001/v1
#   - Mạng nội bộ/VPN: http://<IP_NOI_BO_A>:8000/v1
# LLM_API_KEY là key của Server A (file .api-key trên A), KHÔNG phải key OpenAI.
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-27b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0
# Context của model trên A. Ngân sách input mỗi lần gọi = LLM_CONTEXT_TOKENS - LLM_MAX_TOKENS - 256;
# prompt của expert vượt mức này sẽ bị bỏ bớt chunk xếp hạng thấp (đếm bằng /tokenize của A).
LLM_CONTEXT_TOKENS=65536
LLM_MAX_TOKENS=4096
# Số request chat-api gửi tới A cùng lúc. Đặt bằng MAX_NUM_SEQS của vLLM trên A (hiện là 16).
# Lớn hơn thì request dư xếp hàng trên A mà vẫn bị tính vào LLM_TIMEOUT_SECONDS; nhỏ hơn thì A còn chỗ
# nhưng chat-api vẫn bắt các báo cáo expert chờ nhau. Đặt 1 sẽ chậm hơn nhiều (deep 3 x 4 mất khoảng 300 giây).
LLM_MAX_CONCURRENCY=16
LLM_STRUCTURED_OUTPUT_METHOD=json_schema

# Chat API - Embedding vẫn dùng OpenAI
OPENAI_API_KEY=sk-xxx
EMBEDDING_MODEL=text-embedding-3-large

# Chat API - Retrieval của deep mode (mỗi văn bản là một lần gọi LLM riêng)
# Số văn bản tối đa mỗi chuyên khoa và số chunk tối đa mỗi văn bản.
RETRIEVAL_DEEP_DOCUMENT_LIMIT=4
RETRIEVAL_DEEP_TOP_K=6
# Số chuyên khoa tối đa deep mode tra cứu cho một câu hỏi (basic mode không bị giới hạn bởi số này).
# Mỗi chuyên khoa thêm tối đa RETRIEVAL_DEEP_DOCUMENT_LIMIT báo cáo expert: 3 chuyên khoa x 4 văn bản
# đo được 106 giây tới chữ đầu tiên, 5 chuyên khoa x 4 văn bản là 154 giây (A chạy 16 request song song).
DEEP_MAX_SPECIALTIES=3

# Chat API - Độ dài báo cáo trung gian (expert, tổng hợp bệnh, tổng hợp chuyên khoa), tính bằng số từ.
# Phải đợi đủ báo cáo trung gian mới tổng hợp được, nên báo cáo ngắn thì chữ đầu tiên đến sớm hơn.
# Deep mode áp dụng cho mọi báo cáo trung gian; basic mode chỉ áp dụng khi câu hỏi có nhiều chuyên khoa.
# Câu trả lời cuối cho người dùng (kể cả basic một chuyên khoa) không bị giới hạn bởi số này.
INTERMEDIATE_REPORT_MAX_WORDS=300
